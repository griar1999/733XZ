// Cloudflare Worker settings for PlaneShare (733xz.riarinc.com).
// Deploy: build command `npm run build`, deploy command `npx wrangler deploy`.
// ADMIN_CODE is a secret set in the dashboard (Settings → Variables and Secrets); deploys keep it.
{
  "name": "733xz",
  "main": "server/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist-live",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "planeshare-db", "database_id": "25354af0-8726-4ab2-9ce9-406e8f44eb18" }
  ],
  "keep_vars": true,
  "observability": { "enabled": true }
}
